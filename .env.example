# IntakeQ API
INTAKEQ__API_KEY=your_intakeq_api_key_here
INTAKEQ__BASE_URL=https://intakeq.com/api/v1
INTAKEQ__EXPORT_PROFILE_ID=your_export_profile_id

# S3 Configuration
S3__BUCKET=bucket-name
S3__KEY_PREFIX=migrations/intakeq
S3__SIGNED_URL_EXPIRATION=604800

# AWS Credentials
AWS__REGION=us-east-1

# Application
APP__DATA_DIR=./data
APP__ENV="local"

# Logging
LOG__LEVEL=INFO
LOG__DIR=./logs